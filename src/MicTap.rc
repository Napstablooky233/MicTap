#include <winver.h>

1 VERSIONINFO
FILEVERSION     0,2,0,0
PRODUCTVERSION  0,2,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "MicTap"
            VALUE "FileDescription",  "MicTap - route app audio and microphone into a virtual microphone"
            VALUE "FileVersion",      "0.2.0.0"
            VALUE "InternalName",     "MicTap"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "MicTap.exe"
            VALUE "ProductName",      "MicTap"
            VALUE "ProductVersion",   "0.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
